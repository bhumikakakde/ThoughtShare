# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thoughtshare?retryWrites=true&w=majority

# Any long random string, used to sign login tokens
JWT_SECRET=replace-this-with-a-long-random-string

# Optional: get a free API key at https://developers.giphy.com/ for the GIF picker
GIPHY_API_KEY=
